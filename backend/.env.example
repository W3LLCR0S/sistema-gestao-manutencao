# Copie para backend/.env (ignorado pelo Git) e ajuste. NUNCA coloque senha real neste arquivo de exemplo.
#
# Forma 1 - URL completa:
# MANUTENCAO_DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/manutencao
#
# Forma 2 - por partes (usada quando a URL nao estiver definida):
MANUTENCAO_DB_HOST=localhost
MANUTENCAO_DB_PORT=5432
MANUTENCAO_DB_NAME=manutencao
MANUTENCAO_DB_USER=manutencao
MANUTENCAO_DB_PASSWORD=defina-uma-senha-local

# Apenas para os testes (opcional): um servidor PostgreSQL existente cujo papel possa criar bancos.
# Sem isto, os testes usam o PostgreSQL embutido do pacote de desenvolvimento 'pgserver'.
# NAO aponte para o banco de uso real: os testes criam e removem bancos 'manutencao_teste_*'.
# MANUTENCAO_TEST_SERVER_URL=postgresql://postgres:SENHA@localhost:5432/postgres
